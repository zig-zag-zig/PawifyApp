# Copy to .env.local for local Docker runs.

COMPOSE_PROJECT_NAME=pawify-local
PAWIFY_ENV_FILE=.env.local
PAWIFY_IMAGE=pawify:local
PAWIFY_SECRETS_DIR=./secrets/local
PAWIFY_HOST_BIND_ADDRESS=127.0.0.1
PAWIFY_HOST_PORT=10000
PAWIFY_REDIS_PERSISTENCE=false
PAWIFY_LOG_MAX_SIZE=2m
PAWIFY_LOG_MAX_FILE=30
PAWIFY_LOG_COMPRESS=true
PAWIFY_APP_MEMORY_LIMIT=768m
PAWIFY_APP_MEMORY_SWAP_LIMIT=1g
PAWIFY_APP_MEMORY_RESERVATION=256m
PAWIFY_APP_CPUS=1.0
PAWIFY_APP_PIDS_LIMIT=256
PAWIFY_DAPR_MEMORY_LIMIT=256m
PAWIFY_DAPR_MEMORY_SWAP_LIMIT=384m
PAWIFY_DAPR_MEMORY_RESERVATION=96m
PAWIFY_DAPR_CPUS=0.5
PAWIFY_DAPR_PIDS_LIMIT=128
PAWIFY_REDIS_MEMORY_LIMIT=192m
PAWIFY_REDIS_MEMORY_SWAP_LIMIT=192m
PAWIFY_REDIS_MEMORY_RESERVATION=64m
PAWIFY_REDIS_CPUS=0.5
PAWIFY_REDIS_PIDS_LIMIT=128
PAWIFY_NODE_OPTIONS=--max-old-space-size=384

APP_ENV=local
NODE_ENV=production
PORT=10000
REQUEST_BODY_LIMIT=5mb

LOG_LEVEL=debug
LOG_ERROR_STACKS=true

SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
# Keep this as pawify-api unless you also update dapr/components/resiliency.yaml scopes.
DAPR_APP_ID=pawify-api
# App/provider secret store. Redis uses pawify-env-secrets instead.
DAPR_SECRET_STORE_NAME=pawify-secrets

# Single source for the Redis server password. Dapr reads this same value from
# the pawify-dapr container env through dapr/components/env-secrets.yaml.
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

FIREBASE_DATABASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=/var/pawify/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

NOTIFY_API_KEY=replace-with-local-notify-token

MUSICBRAINZ_USER_AGENT=Pawify-Local/1.0
MUSICBRAINZ_DELAY_MS=650
MUSICBRAINZ_MIN_RATE_LIMIT_WAIT_MS=1500
MUSICBRAINZ_RETRY_AFTER_BUFFER_MS=1000

# Shared token buckets, enforced across every server instance via Dapr state.
# Burst = tokens available instantly; REFILL_PER_SECOND is the sustained average.
# MusicBrainz enforces a 1 req/sec average per IP. Bursting 5 was measured to be
# unreliable (identical bursts returned 200 and 503), and each 503 costs a ~10s pause,
# so the default is strict 1/sec. Raise the burst only to experiment.
RATE_LIMIT_MUSICBRAINZ_BURST=1
RATE_LIMIT_MUSICBRAINZ_REFILL_PER_SECOND=1
RATE_LIMIT_MUSICBRAINZ_STAGGER_MS=50
# Discogs: 60 req/min authenticated.
RATE_LIMIT_DISCOGS_BURST=5
RATE_LIMIT_DISCOGS_REFILL_PER_SECOND=1
RATE_LIMIT_DISCOGS_STAGGER_MS=50
# Deezer: 50 req/5s per IP, run at ~80% of budget.
RATE_LIMIT_DEEZER_BURST=40
RATE_LIMIT_DEEZER_REFILL_PER_SECOND=8
RATE_LIMIT_DEEZER_STAGGER_MS=0
RATE_LIMIT_STATE_STORE=pawify-state
# Used only if shared state is unreachable; limiting then degrades to per-process.
RATE_LIMIT_FALLBACK_MAX_CONCURRENT=1
RATE_LIMIT_FALLBACK_DELAY_MS=1000

# Tidal artist-image lookups. The Dapr secret `tidal-token` takes precedence
# over TIDAL_API_TOKEN, and the code falls back to a shared public community
# token when neither is set, so both are optional.
# TIDAL_API_TOKEN=
TIDAL_COUNTRY_CODE=US

ARTIST_CACHE_TTL_HOURS=336
TRANSIENT_ARTIST_CACHE_TTL_HOURS=24
RELEASE_LYRICS_CACHE_TTL_HOURS=336
# Shared per-artist release-scan cache for the new-release notification run.
# Deliberately short: dedupes per-artist MusicBrainz fetches within a run, but
# expires before the next scheduled scan so new releases surface promptly.
RELEASE_SCAN_CACHE_TTL_HOURS=2
# Number of individual release pushes before the remainder becomes one digest.
MAX_INDIVIDUAL_RELEASE_NOTIFICATIONS=3
CACHE_DEFAULT_TTL_HOURS=336
ARTIST_METADATA_REFRESH_TTL_MS=2419200000
TRANSIENT_REMOTE_VALUE_RETRY_WINDOW_MS=300000

BACKGROUND_TASK_RESULT_RETENTION_MS=90000
BACKGROUND_TASK_CLEANUP_INTERVAL_MS=30000
BACKGROUND_TASK_MAX_CONCURRENCY=8
BACKGROUND_TASK_PENDING_ORPHAN_TTL_MS=600000
BACKGROUND_TASK_WORKER_TIMEOUT_MS=450000
BACKGROUND_TASK_SUBTASK_ITEM_LIMIT=30
BACKGROUND_TASK_PROGRESS_NOTIFY_THROTTLE_MS=2000
BACKGROUND_TASK_COVER_ART_REQUEST_CONCURRENCY=40
BACKGROUND_TASK_TRACK_LYRICS_REQUEST_CONCURRENCY=20
BACKGROUND_TASK_ARTIST_PROFILE_IMAGE_REQUEST_CONCURRENCY=10
NOTIFY_NEW_RELEASES_LOCK_TTL_MS=3600000

# DEV ONLY: set to "true" to bypass the production PASSWORD_RESET_PEPPER
# requirement locally. The OTP service then uses an insecure dev pepper.
# NEVER set this in production (APP_ENV=production / NODE_ENV=production).
# ALLOW_INSECURE_PASSWORD_RESET_PEPPER=true
