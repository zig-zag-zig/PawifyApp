{
    "name": "@pawify/shared",
    "version": "1.0.0",
    "private": true,
    "description": "Shared music-domain types and display/date helpers used by Pawify API (apps/server) and Pawify App (apps/mobile). Source-only TypeScript; each consumer compiles/bundles it directly.",
    "license": "0BSD",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "react-native": "src/index.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "src",
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "typescript": "^5.8.2"
    }
}
